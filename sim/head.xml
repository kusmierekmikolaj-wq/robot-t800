<mujoco model="t800_head">
  <!-- Prosta głowa na szyi z dwoma stopniami swobody (pan/tilt). Zakresy zgodne z brain/safety.py. -->
  <compiler angle="degree"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="1 1 0.1" rgba="0.2 0.2 0.22 1"/>
    <body name="base" pos="0 0 0.03">
      <geom type="cylinder" size="0.06 0.03" rgba="0.3 0.3 0.35 1"/>
      <body name="neck" pos="0 0 0.06">
        <joint name="pan" type="hinge" axis="0 0 1" range="-90 90" damping="0.05"/>
        <geom type="cylinder" size="0.02 0.03" rgba="0.6 0.6 0.65 1"/>
        <body name="head" pos="0 0 0.04">
          <joint name="tilt" type="hinge" axis="0 1 0" range="-30 40" damping="0.05"/>
          <geom name="skull" type="box" size="0.06 0.05 0.07" pos="0 0 0.07" rgba="0.75 0.75 0.78 1"/>
          <geom name="eye_l" type="sphere" size="0.011" pos="0.062 0.025 0.09" rgba="1 0 0 1" contype="0" conaffinity="0"/>
          <geom name="eye_r" type="sphere" size="0.011" pos="0.062 -0.025 0.09" rgba="1 0 0 1" contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- ctrl w radianach (jednostki wewnętrzne MuJoCo): +-90 stopni = +-1.5708; tilt -30..40 stopni = -0.5236..0.6981 -->
    <position name="pan_act" joint="pan" kp="30" kv="1" ctrlrange="-1.5708 1.5708"/>
    <position name="tilt_act" joint="tilt" kp="30" kv="1" ctrlrange="-0.5236 0.6981"/>
  </actuator>
</mujoco>
